{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "TURBO_TELEMETRY_DISABLED": "1"
  },
  "permissions": {
    "allow": [
      "Bash(npm ci)",
      "Bash(npm run build:cached)",
      "Bash(npm run check:fast)",
      "Bash(npm run check:changed)",
      "Bash(npm run test:local:*)",
      "Bash(npm run test:focused:*)",
      "Bash(npm run test:changed)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run format)",
      "Bash(npm run format:check)",
      "Bash(npm run docs:check)",
      "Bash(npm run knip)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
